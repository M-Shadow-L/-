    document.documentElement.style.setProperty('--px', pointer.x.toFixed(4));
    document.documentElement.style.setProperty('--py', pointer.y.toFixed(4));
    heartView.x = lerp(heartView.x, heartView.tx, 1 - Math.exp(-3.6 * dt));
    heartView.y = lerp(heartView.y, heartView.ty, 1 - Math.exp(-3.6 * dt));
    heartView.s = lerp(heartView.s, heartView.ts, 1 - Math.exp(-3.6 * dt));
    heartView.a = lerp(heartView.a, heartView.ta, 1 - Math.exp(-3.2 * dt));
    fx.star = lerp(fx.star, fx.starTarget, 1 - Math.exp(-2.8 * dt));
    fx.warp *= Math.exp(-2.2 * dt);
    ctx.clearRect(0, 0, W, H);
    drawStars(time, dt);
    drawHeart(time);
    updateSparks(dt);
    drawPetals(time, dt);
    if (!coarsePointer) {
      mouse.ringX = lerp(mouse.ringX, mouse.x, 1 - Math.exp(-14 * dt));
      mouse.ringY = lerp(mouse.ringY, mouse.y, 1 - Math.exp(-14 * dt));
      if (cursorDot) cursorDot.style.transform = `translate3d(${mouse.x}px,${mouse.y}px,0)`;
      if (cursorRing) cursorRing.style.transform = `translate3d(${mouse.ringX}px,${mouse.ringY}px,0)`;
    }
    requestAnimationFrame(frame);
  }
  /* ══════════════════════════════════════════════════════════
     3. 场景、转场与交互
     ══════════════════════════════════════════════════════════ */
  const scenes = SCENE_KEYS.map(key => $(`#scene-${key}`));
  const finalScene = $('#scene-final');
  const proposal = $('.proposal');
  const forever = $('.forever');
  const navButtons = $$('.nav-item');
  const nav = $('.chapter-nav');
  const nextBtn = $('#nextBtn');
  const chapterCount = $('#chapterCount');
  const autoTrack = $('#autoTrack');
  const transit = $('#transit');
  const live = $('#live');
  const toast = $('#toast');
  const teaseBtn = $('#teaseBtn');
  const yesBtn = $('#yesBtn');
  const replayBtn = $('#replayBtn');
  const cursorDot = $('#cursorDot');
  const cursorRing = $('#cursorRing');
  let current = -1;
  let locked = false;
  let accepted = false;
  let autoTimer = null;
  let toastTimer = null;
  let teaseCount = 0;
  function updateHUD() {
    const chapter = current === 0 ? 0 : current;
    chapterCount.innerHTML = `<b>${String(chapter).padStart(2, '0')}</b> / 05`;
    navButtons.forEach(button => {
      const active = Number(button.dataset.go) === current;
      button.classList.toggle('is-active', active);
      if (active) button.setAttribute('aria-current', 'step');
      else button.removeAttribute('aria-current');
      button.tabIndex = accepted || current === 0 || current === 5 ? -1 : 0;
    });
    const hideNext = current === 0 || current === 5 || accepted;
    nextBtn.classList.toggle('is-hidden', hideNext);
    nextBtn.tabIndex = hideNext ? -1 : 0;
  }
  function updateSceneKey(key) {
    document.body.dataset.scene = key;
    const dim = STAR_DIM[key] !== undefined ? STAR_DIM[key] : .7;
    fx.starTarget = dim;
    setHeartTarget(key);
    updateHUD();
  }
  function activate(index, options = {}) {
    const key = SCENE_KEYS[index];
    if (!scenes[index]) return;
    if (key !== 'final' && accepted) resetAccepted();
    if (key === 'final' && !accepted) {
      finalScene.classList.remove('is-accepted');
      proposal.inert = false;
      forever.setAttribute('aria-hidden', 'true');
      teaseBtn.style.transform = '';
      teaseBtn.textContent = '让我再想想';
      teaseCount = 0;
    }
    scenes.forEach((scene, sceneIndex) => {
      const isActive = sceneIndex === index;
      scene.classList.toggle('is-active', isActive);
      scene.setAttribute('aria-hidden', String(!isActive));
    });
    current = index;
    updateSceneKey(key);
    if (!options.initial) live.textContent = SCENE_LABELS[key];
  }
  function clearAuto() {
    if (autoTimer) window.clearTimeout(autoTimer);
    autoTimer = null;
    autoTrack.classList.remove('is-running');
    autoTrack.style.removeProperty('--dur');
  }
  function scheduleAuto() {
    clearAuto();
    if (!CONFIG.auto || reducedMotion || accepted || locked) return;
    const key = SCENE_KEYS[current];
    const delay = CONFIG.autoDelays[key] || 0;
    if (!delay || current >= 5) return;
    autoTrack.style.setProperty('--dur', `${delay}ms`);
    void autoTrack.offsetWidth;
    autoTrack.classList.add('is-running');
    autoTimer = window.setTimeout(() => {
      if (!locked && !accepted && current < 5) goTo(current + 1);
    }, delay);
  }
  const TRANSITION_HTML = {
    warp: `<div class="warp-lines"></div><div class="warp-flash"></div>`,
    iris: `<div class="iris-ink"></div><div class="iris-halo"></div>`,
    burst: `<div class="burst-flash"></div><div class="burst-ring r1"></div><div class="burst-ring r2"></div><div class="burst-ring r3"></div>`,
    page: text => `<div class="page-3d"><div class="sheet"><span>${text}</span></div></div>`,
    curtain: `<div class="panel left"></div><div class="panel right"></div><div class="seam"></div>`,
    bloom: `<div class="bloom-glow"></div><div class="bloom-ring"></div><div class="bloom-ring d"></div>`
  };
  function transitionMarkup(type, text) {
    const value = TRANSITION_HTML[type] || TRANSITION_HTML.iris;
    return typeof value === 'function' ? value(text) : value;
  }
  function transitionFX(type, targetKey) {
    if (type === 'warp') fx.warp = 2.5;
    if (type === 'burst') {
      const x = heartView.a > .18 ? W * heartView.x : W * .5;
      const y = heartView.a > .18 ? H * heartView.y : H * .48;
      triggerBurst(x, y, 150, 'mixed', 1.05);
    }
    if (type === 'bloom') {
      triggerBurst(W * .5, H * .3, 120, 'celebration', 1);
    }
    if (type === 'iris') fx.warp = .2;
  }
  function playTransition(type, swap, options = {}) {
    return new Promise(resolve => {
      if (reducedMotion) {
        swap();
        window.setTimeout(resolve, 220);
        return;
      }
      const times = TRANSITION_TIME[type] || TRANSITION_TIME.iris;
      const text = options.pageText || (type === 'page' ? '见 字 如 面' : '致 你');
      document.body.classList.add('is-changing');
      transit.className = `transition is-on t-${type}`;
      transit.innerHTML = transitionMarkup(type, text);
      transitionFX(type, options.targetKey);
      if (type === 'iris') {
        requestAnimationFrame(() => transit.classList.add('phase-close'));
      } else if (type === 'page' || type === 'curtain') {
        requestAnimationFrame(() => transit.classList.add('go'));
      }
      window.setTimeout(() => {
        try {
          swap();
          sound.chime(type);
        } catch (error) {
          console.error('Transition swap failed:', error);
        }
        if (type === 'iris') {
          const ink = $('.iris-ink', transit);
          if (ink) ink.style.clipPath = 'circle(150vmax at 50% 50%)';
          transit.classList.remove('phase-close');
          void transit.offsetWidth;
          transit.classList.add('phase-open');
        }
      }, times.swap);
      window.setTimeout(() => {
        transit.className = 'transition';
        transit.innerHTML = '';
        document.body.classList.remove('is-changing');
        resolve();
      }, times.end);
    });
  }
  async function goTo(target, options = {}) {
    const index = clamp(Number(target), 0, SCENE_KEYS.length - 1);
    if (locked || index === current || accepted) return;
    if (options.instant) {
      activate(index, options);
      scheduleAuto();
      return;
    }
    clearAuto();
    locked = true;
    const key = SCENE_KEYS[index];
    const type = options.type || TRANSITION_FOR[key] || 'iris';
    await playTransition(type, () => {
      activate(index, options);
    }, { ...options, targetKey: key });
    locked = false;
    scheduleAuto();
  }
  function resetAccepted() {
    accepted = false;
    document.body.classList.remove('is-accepted');
    finalScene.classList.remove('is-accepted');
    if (proposal) proposal.inert = false;
    if (forever) forever.setAttribute('aria-hidden', 'true');
    if (nav) nav.removeAttribute('inert');
    stopCelebration();
    updateHUD();
  }
  function applyAccepted(instant = false) {
    accepted = true;
    finalScene.classList.add('is-accepted');
    document.body.classList.add('is-accepted');
    proposal.inert = true;
    forever.setAttribute('aria-hidden', 'false');
    nav.setAttribute('inert', '');
    clearAuto();
    updateHUD();
    setHeartTarget('final');
    startCelebration();
    live.textContent = '好，在一起。余生请多指教。';
  }
  async function accept() {
    if (accepted || locked || current !== 5) return;
    locked = true;
    clearAuto();
    await playTransition('bloom', () => {
      applyAccepted(false);
      sound.swell();
    }, { targetKey: 'final' });
    locked = false;
  }
  function showToast(message) {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.add('show');
    if (toastTimer) window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => toast.classList.remove('show'), 3200);
  }
  function startExperience() {
    sound.enable();
    goTo(1, { type: 'warp' });
  }
  /* ══════════════════════════════════════════════════════════
     4. 事件绑定
     ══════════════════════════════════════════════════════════ */
  function bindEvents() {
    $('#startBtn').addEventListener('click', startExperience);
    $('#soundBtn').addEventListener('click', () => sound.toggle());
    nextBtn.addEventListener('click', () => goTo(current + 1));
    $('#letterNext').addEventListener('click', () => goTo(4, { type: 'page', pageText: '下 一 页' }));
    $('#galleryNext').addEventListener('click', () => goTo(5, { type: 'curtain' }));
    yesBtn.addEventListener('click', accept);
    replayBtn.addEventListener('click', () => {
      resetAccepted();
      goTo(0, { type: 'iris' });
    });
    navButtons.forEach(button => {
      button.addEventListener('click', () => {
        const target = Number(button.dataset.go);
        const text = target === 4 ? '下 一 页' : '见 字 如 面';
        goTo(target, target === 4 ? { pageText: text } : {});
      });
    });
    teaseBtn.addEventListener('click', event => {
      const fromPointer = event.detail > 0;
      if (teaseCount >= 3) {
        showToast('没关系，喜欢本来就不需要马上回答。');
        return;
      }
      if (fromPointer) {
        const rect = teaseBtn.getBoundingClientRect();
        const direction = rect.left < W * .5 ? 1 : -1;
        const x = direction * rand(18, Math.min(62, W * .12));
        const y = rand(-20, 20);
        teaseBtn.style.transform = `translate3d(${x}px,${y}px,0)`;
      }
      teaseCount++;
      teaseBtn.textContent = teaseCount >= 3 ? '好，我等你' :
        (teaseCount === 1 ? '再想想嘛…' : '真的不再想想？');
      showToast(teaseCount === 1 ? '它有一点紧张，跑掉了。' :
        (teaseCount === 2 ? '再点一次，它可能就停下来了。' : '心意先放在这里，不着急。'));
    });
    window.addEventListener('pointermove', event => {
      if (event.pointerType === 'touch') return;
      mouse.x = event.clientX;
      mouse.y = event.clientY;
      pointer.tx = (event.clientX / W - .5) * 2;
      pointer.ty = (event.clientY / H - .5) * 2;
      document.documentElement.classList.add('has-custom-cursor');
      const interactive = !!event.target.closest('button, a, .polaroid');
      document.body.classList.toggle('cursor-hot', interactive);
    }, { passive: true });
    document.addEventListener('mouseleave', () => {
      document.documentElement.classList.remove('has-custom-cursor');
      document.body.classList.remove('cursor-hot');
    });
    document.addEventListener('mouseenter', () => {
      if (!coarsePointer) document.documentElement.classList.add('has-custom-cursor');
    });
    document.addEventListener('keydown', event => {
      if (/^(INPUT|TEXTAREA|SELECT)$/.test(event.target.tagName)) return;
      const onButton = !!event.target.closest('button, a');
      if (event.code === 'Space' && onButton) return;
      if (event.code === 'Space' || event.code === 'ArrowRight' || event.code === 'PageDown') {
        event.preventDefault();
        if (locked || accepted) return;
        if (current === 0) startExperience();
        else if (current < 5) goTo(current + 1);
        return;
      }
      if (event.code === 'ArrowLeft' || event.code === 'PageUp') {
        event.preventDefault();
        if (locked || accepted) return;
        if (current > 0) goTo(current - 1);
        return;
      }
      if (event.key === 'm' || event.key === 'M') sound.toggle();
    });
    let touchStart = null;
    document.addEventListener('touchstart', event => {
      if (event.touches.length !== 1) return;
      touchStart = { x: event.touches[0].clientX, y: event.touches[0].clientY };
    }, { passive: true });
    document.addEventListener('touchend', event => {
      if (!touchStart) return;
      const touch = event.changedTouches[0];
      const dx = touch.clientX - touchStart.x;
      const dy = touch.clientY - touchStart.y;
      touchStart = null;
      if (locked || accepted || Math.abs(dx) < 62 || Math.abs(dx) < Math.abs(dy) * 1.35) return;
      if (dx < 0) {
        if (current === 0) startExperience();
        else if (current < 5) goTo(current + 1);
      } else if (current > 0) {
        goTo(current - 1);
      }
    }, { passive: true });
    window.addEventListener('resize', () => {
      resizeCanvas();
      setHeartTarget(SCENE_KEYS[Math.max(0, current)]);
    });
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        clearAuto();
      } else if (!locked && !accepted) {
        scheduleAuto();
      }
    });
  }
  /* ══════════════════════════════════════════════════════════
     5. 启动
     ══════════════════════════════════════════════════════════ */
  function init() {
    if (params.get('snap') === '1') {
      document.documentElement.classList.add('static-preview');
    }
    initSprites();
    resizeCanvas();
    bindEvents();
    const requested = (params.get('scene') || 'intro').toLowerCase();
    let startIndex = SCENE_KEYS.indexOf(requested);
    if (startIndex === -1) startIndex = 0;
    const startAccepted = requested === 'accepted';
    if (startAccepted) startIndex = 5;
    activate(startIndex, { initial: true });
    requestAnimationFrame(frame);
    if (startAccepted) {
      window.setTimeout(() => {
        if (!accepted) applyAccepted(true);
      }, 500);
    } else if (startIndex > 0) {
      scheduleAuto();
    }
    // 让首屏标题在字体加载后仍保持稳定
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(() => {
        document.documentElement.classList.add('fonts-ready');
      }).catch(() => {});
    }
  }
  init();
})();
</script>
</body>
